# Core runtime
WRTC_SIM_MODE=headless
WRTC_SIM_HOST=0.0.0.0
WRTC_SIM_PORT=8080
WRTC_SIM_LOG_LEVEL=INFO

# Signaling
WRTC_SIGNALING_TRANSPORT=websocket
WRTC_SIGNALING_HTTP_ENABLED=true
WRTC_SIGNALING_WS_ENABLED=true

# Scenario
WRTC_SCENARIO_FILE=configs/scenarios/single-peer.yaml
WRTC_PEER_DEFAULT_COUNT=1

# Media defaults
WRTC_VIDEO_PROFILE=configs/media/default-video.yaml
WRTC_AUDIO_PROFILE=configs/media/default-audio.yaml

# ICE/TURN placeholders
WRTC_STUN_URLS=stun:stun.l.google.com:19302
WRTC_TURN_URLS=
WRTC_TURN_USERNAME=
WRTC_TURN_CREDENTIAL=

# Metrics
WRTC_METRICS_ENABLED=true
WRTC_METRICS_EXPORTER=log
